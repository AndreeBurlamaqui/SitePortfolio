---
import TechTags from './tech-tags.astro';
import { getGalleryMedia } from '../utils/media';

const { entry, basePath } = Astro.props;
const { data, slug } = entry;
const previewMedia = getGalleryMedia(slug).slice(0, 5); // 5 max preview on hover
---

<a href={`${basePath}/${slug}`} class="project-card" data-card>
    
  <div class="card-preview-wrapper">

    <div class="card-image" style={`background-image: url(${data.cover})`}/>
    
    {previewMedia.length > 0 && (
      <div class="card-gallery-slide">
        {previewMedia.map((item, index) => (
          item.type === 'video' ? (
            <video src={item.src} muted loop playsinline class="gallery-preview-item" data-index={index}></video>
          ) : (
            <img src={item.src} alt="" loading="lazy" class="gallery-preview-item" data-index={index} />
          )
        ))}
      </div>
    )}

  </div>

  <div class="entry-info">
      <h3>{data.title}</h3>
      {data.studio && <small>Developed by: {data.studio}</small>}
      <small>{data.role}</small>
      <small>{data.timeFrame}</small>
  </div>


<!-- <hr> -->

<div class="card-info">
    
  <div class="tags-container">
    <TechTags rawTechStack={[
      data.engine,
      data.language,
      data.importantTechStack,
      data.githubUrl && "OSS"
    ]}/>
  </div>

<hr style="margin-top: auto">

<!-- {data.itchUrl || data.steamUrl || data.googlePlayUrl || data.applePlayUrl ? ( -->
    <div class="store-icons">
                {data.itchUrl && <i class="fa-brands fa-itch-io" title="Itch.io"></i>}
                {data.steamUrl && <i class="fa-brands fa-steam" title="Steam"></i>}
                {data.googlePlayUrl && <i class="fa-brands fa-google-play" title="Google Play"></i>}
                {data.applePlayUrl && <i class="fa-brands fa-apple" title="App Store"></i>}
                {data.importantTechStack && data.importantTechStack.includes("WebGL") &&
                <i class="fa-solid fa-globe" title="WebGL"></i>}
                {data.importantTechStack && data.importantTechStack.includes("PC") &&
                <i class="fa-solid fa-desktop" title="PC"></i>}
                {data.githubUrl && <i class="fa-brands fa-github" title="GitHub Repository"></i>}
            </div>
        <!-- ) : null} -->
  </div>
</a>

<script>
  // Simple slideshow script for the cards
  const cards = document.querySelectorAll('[data-card]');

  cards.forEach(card => {
    let intervalId: number;
    let currentIndex = 0;
    const items = card.querySelectorAll('.gallery-preview-item') as NodeListOf<HTMLElement>;
    
    if (items.length === 0) return;

    card.addEventListener('mouseenter', () => {
      // Show first item immediately
      items.forEach(el => el.style.opacity = '0');
      items[currentIndex].style.opacity = '1';
      if (items[currentIndex].tagName === 'VIDEO') (items[currentIndex] as HTMLVideoElement).play();

      // Cycle every few seconds
      intervalId = window.setInterval(() => {
        if (items[currentIndex].tagName === 'VIDEO') (items[currentIndex] as HTMLVideoElement).pause();
        items[currentIndex].style.opacity = '0';
        
        currentIndex = (currentIndex + 1) % items.length;
        
        items[currentIndex].style.opacity = '1';
        if (items[currentIndex].tagName === 'VIDEO') (items[currentIndex] as HTMLVideoElement).play();
      }, 3000);
    });

    card.addEventListener('mouseleave', () => {
      clearInterval(intervalId);
      // Reset everything, let the default cover show
      items.forEach(el => {
        el.style.opacity = '0';
        if (el.tagName === 'VIDEO') {
          const vid = el as HTMLVideoElement;
          vid.pause();
          vid.currentTime = 0;
        }
      });
      currentIndex = 0;
    });
  });
</script>

<style>
  .project-card {
    text-decoration: none;
    color: inherit;
    border: 1px solid #eee;
    border-radius: 12px;
    background: #fafafa;
    transition: transform 0.2s, box-shadow 0.2s;
    height: 100%; /* Ensures all cards in a row match height */
    width: 275px;
  }

  .project-card:hover { 
    transform: translateY(-5px); 
    box-shadow: 0 10px 20px rgba(0,0,0,0.08); 
  }

  .card-preview-wrapper{
    position: relative;
    width: 100%;
    height: 250px;
    overflow: hidden;
    border-radius: 12px 12px 0 0;
  }
  .card-image {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-color: #f0f0f0;
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-gallery-slide {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none; /* Let the card handle hovers */
  }

  .gallery-preview-item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.25s ease-in-out;
  }

  .card-info { 
    padding: 1rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
    justify-content: flex-start;
  }

  h3 { 
    margin: 0.5rem 0 0.5rem 0; 
    font-size: 1.75rem;
    line-height: 1.2;

    overflow: visible;

    height: 3.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
 }

  .store-icons {
    margin-top: auto; /* Pushes icons to the bottom */
    justify-content: flex-end; /* This pushes items to the right */
    display: flex;
    gap: 0.8rem;
    color: #666;
    font-size: 1.1rem;
  }
  
  .entry-info{
    text-align: center;
    margin: 1rem auto;

    
    display: grid;
    grid-template-rows: auto 1.2em 1.2em 0; /* Title is the only flex grid */
    gap: 0;
  }

  .entry-info small {
    display: block; /* Forces them to new lines */
    line-height: 1.2;
    color: #666;
  }

  .tags-container {
  height: 3rem;  /* 2 rows max*/
  width: 100%;
  
  /* Push tags to the bottom of this box */
  display: flex;
  flex-direction: column;
  justify-content: flex-end; 
}

</style>